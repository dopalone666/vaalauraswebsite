# Only these three secrets are needed (set them in Cloudflare Dashboard -> Worker -> Settings -> Variables and Secrets,
# or locally in a .dev.vars file for `npm run dev`).

# Any random string, 32+ characters. Used to sign your admin session cookie.
SESSION_SIGNING_SECRET=""

# Your admin login (the only login on the site).
DEV_LOGIN_EMAIL=""
DEV_LOGIN_PASSWORD=""

# Fine-grained read-only GitHub PAT (Contents: Read on MayuzumiSayaka/cucky)
# used by /api/releases/latest and /api/releases/download/* to serve private release updates securely.
GITHUB_RELEASES_TOKEN=""
# Optional override (defaults to MayuzumiSayaka/cucky).
GITHUB_RELEASES_REPO="MayuzumiSayaka/cucky"
