{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "vaalauras-auth",
  "main": "worker.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_NAME": "VaalAuras",
    "CREATOR_DISPLAY_NAME": "VaalAuras",
    "APP_PROTOCOL_SCHEME": "vaalauras",
    "APP_LOCALHOST_PORT": "48912",
    "PATREON_MIN_TIER_CENTS": "500",
    "DEV_TWITCH_LOGINS": "dopalonee"
  }
  // Required to save user Lifetime Access grants and Guide & Changelog posts permanently on Cloudflare:
  // Create a free KV namespace (`npx wrangler kv namespace create CONTENT_KV` or via Dashboard),
  // bind it in Worker Settings -> Bindings (or uncomment below):
  // ,
  // "kv_namespaces": [
  //   { "binding": "CONTENT_KV", "id": "YOUR_KV_NAMESPACE_ID" }
  // ]
}
