{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "vaalauras-auth",
  "main": "worker.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Keep the existing vaalauras-content namespace attached on every deploy.
  "kv_namespaces": [
    { "binding": "CONTENT_KV", "id": "66bd512b6ca74affb8868f04d4c1ba71" }
  ]
}
