{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "vaalauras-auth",
  "main": "worker.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
  // Required so your home page, guide and changelog edits are saved permanently.
  // Create a KV namespace (`npx wrangler kv namespace create CONTENT_KV` or via the Dashboard),
  // then bind it in Worker Settings -> Bindings (variable name: CONTENT_KV) or uncomment below:
  // ,
  // "kv_namespaces": [
  //   { "binding": "CONTENT_KV", "id": "YOUR_KV_NAMESPACE_ID" }
  // ]
}
